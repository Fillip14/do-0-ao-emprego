  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "PGDATABASE=tasks_dev tsx watch --env-file=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && NODE_ENV=test PGDATABASE=tasks_test vitest",
    "build": "tsc -p tsconfig.build.json",
    "db:schema": "psql -h localhost -U fillip -d tasks_dev -f sql/schema.sql && psql -h localhost -U fillip -d tasks_test -f sql/schema.sql"
  },
  "dependencies": {
    "express": "^5.2.1",
    "morgan": "^1.11.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.1",
    "@usebruno/cli": "^4.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
